              </p:TypeAnnotation>
              <p:ValueBoxSettings>
                <p:maxvisibleentries p:Type="Int32">12</p:maxvisibleentries>
              </p:ValueBoxSettings>
              <p:Value>
                <Item>Choose your poison.</Item>
                <Item>Time to make a decision.</Item>
                <Item>Red or Blue?</Item>
                <Item>And the answer is...</Item>
                <Item>What do _YOU_ want?</Item>
                <Item>Where is life taking you?</Item>
                <Item>Have you considered...</Item>
                <Item>Today on the menu:</Item>
                <Item>Make a choice, sir.</Item>
                <Item>Choose Your Destiny</Item>
              </p:Value>
            </Pad>
